# Template only. Validate with nginx -t on the deployment host.
# TLS files/domain and trusted CDN addresses must be supplied by the operator.
limit_req_zone $binary_remote_addr zone=shop_login:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=shop_api:20m rate=250r/s;
limit_conn_zone $binary_remote_addr zone=shop_connections:10m;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name shop.example.invalid;
    ssl_certificate /etc/ssl/shop/fullchain.pem;
    ssl_certificate_key /etc/ssl/shop/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 20s;
    send_timeout 10s;
    client_max_body_size 64k;
    limit_conn shop_connections 300;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=15552000" always;
    # With a CDN, enable real_ip only for verified CIDRs and firewall BOTH
    # IPv4/IPv6 origin interfaces to those CIDRs. Never trust all senders.
    # include /etc/nginx/shop-trusted-edge.conf;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_read_timeout 10s;
    proxy_send_timeout 10s;
    proxy_cache off;
    location = /api/v1/auth/login {
        limit_req zone=shop_login burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
    }
    location ~ ^/api/v1/admin/products/[0-9]+/images$ {
        client_max_body_size 6m;
        limit_req zone=shop_api burst=100 nodelay;
        proxy_pass http://127.0.0.1:8080;
    }
    location /actuator { deny all; }
    location /api/ {
        limit_req zone=shop_api burst=500 nodelay;
        proxy_pass http://127.0.0.1:8080;
    }
    location / { proxy_pass http://127.0.0.1:8080; }
}
